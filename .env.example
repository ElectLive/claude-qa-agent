# =============================================================
# Copy this file to .env and fill in your values.
# cp .env.example .env
# =============================================================

# ─────────────────────────────────────────────────────────────
# GitLab
# ─────────────────────────────────────────────────────────────
GITLAB_TOKEN=your_gitlab_personal_access_token
# Numeric or URL-encoded path project ID (e.g. "42" or "your-group%2Fyour-project")
GITLAB_PROJECT_ID=your-project-id
# Base URL — default https://gitlab.com; set to your self-hosted instance otherwise
GITLAB_URL=https://gitlab.com

# ─────────────────────────────────────────────────────────────
# Environments
# ─────────────────────────────────────────────────────────────
STAGING_URL=https://staging.myapp.com
PROD_URL=https://myapp.com
FEATURE_BASE_URL=https://feature.myapp.com

# ─────────────────────────────────────────────────────────────
# API Testing
# ─────────────────────────────────────────────────────────────
# Auth token used for API test cases (placeholder — not a real credential)
API_TEST_TOKEN=test-bearer-token-here
# API response time threshold in ms (default: 2000)
API_PERF_THRESHOLD_MS=2000

# ─────────────────────────────────────────────────────────────
# Competitor Benchmark (WAY 7)
# ─────────────────────────────────────────────────────────────
# Optional — only needed to clone PRIVATE GitHub repos as a benchmark target
# (private GitLab repos reuse GITLAB_TOKEN). Read-only scope is enough.
GITHUB_TOKEN=

# ─────────────────────────────────────────────────────────────
# Artifacts — local storage paths (no need to change)
# ─────────────────────────────────────────────────────────────
SCREENSHOT_DIR=./qa-artifacts/screenshots
API_RESPONSE_DIR=./qa-artifacts/api-responses
SESSION_DIR=./qa-artifacts/sessions
CI_REPORT_DIR=./qa-artifacts/ci
BENCHMARK_DIR=./qa-artifacts/benchmarks
# Accessibility results no longer have their own folder — they're part of each
# scenario's test-execution-agent output (test-writer bakes an axe-core step
# into every UI scenario instead of running a separate pass)
